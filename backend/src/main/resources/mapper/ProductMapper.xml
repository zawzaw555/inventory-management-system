<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.inventory.mapper.ProductMapper">
    
    <!-- SELECT -->
    <select id="findAll"
    		resultType="com.example.inventory.model.Product">
    	
    	SELECT
    		id,
    		name,
    		sku,
    		price,
    		category_id,
    		stock_quantity,
    		created_at
    	FROM products;
    	
    </select>
    
    <!-- SELECT BY ID -->
    <select id="findById"
    		resultType="com.example.inventory.model.Product">
    	
    	SELECT
    		id,
    		name,
    		sku,
    		price,
    		category_id,
    		stock_quantity,
    		created_at
    	FROM products
    	WHERE id = #{id}
    	
    </select>
    
    <!-- INSERT -->
    <insert id="insert"
    		parameterType="com.example.inventory.model.Product"
    		useGeneratedKeys="true"
    		keyProperty="id">
    	
    	INSERT INTO products
    		(name, sku, price, category_id)
    	VALUES
    		(#{name}, #{sku}, #{price}, #{categoryId})
    		
    </insert>
    
    <!-- UPDATE BY ID -->
    <update id="update"
    		parameterType="com.example.inventory.model.Product">
    
    	UPDATE products
    	SET
    		name = #{name},
    		sku = #{sku},
    		price = #{price},
    		category_id = #{categoryId}
    	WHERE id = #{id}
    	
    </update>
    
    <!-- DELETE -->
    <delete id="deleteById">
    
    	DELETE FROM products
    	WHERE id = #{id}
    	
    </delete>
    
</mapper>